{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krzysztofdudek.github.io/Yggdrasil/schemas/yg-find-1.schema.json",
  "title": "Search results (yg find --json)",
  "type": "object",
  "properties": {
    "schema": {
      "const": "yg-find/1"
    },
    "query": {
      "description": "The query, trimmed.",
      "type": "string"
    },
    "results": {
      "description": "At most five results; empty when nothing matched or the graph is empty.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/FindJsonResult"
      }
    }
  },
  "required": [
    "schema",
    "query",
    "results"
  ],
  "additionalProperties": false,
  "$defs": {
    "FindJsonResult": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "aspect",
            "file",
            "node"
          ]
        },
        "id": {
          "description": "A node's path (a valid --node argument), a rule's id, or a file's path.",
          "type": "string"
        },
        "type": {
          "type": [
            "null",
            "string"
          ]
        },
        "status": {
          "description": "A rule's default status; null for anything else.",
          "type": [
            "null",
            "string"
          ]
        },
        "description": {
          "type": "string"
        },
        "score": {
          "description": "Relevance relative to the best match (1 for the top result).",
          "type": "number"
        },
        "matched": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next": {
          "description": "The command that shows this result's context, or null for a rule (read its file).",
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "type",
        "status",
        "description",
        "score",
        "matched",
        "next"
      ],
      "additionalProperties": false
    }
  }
}
