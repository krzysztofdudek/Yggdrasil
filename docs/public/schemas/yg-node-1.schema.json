{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krzysztofdudek.github.io/Yggdrasil/schemas/yg-node-1.schema.json",
  "title": "Component (yg node --json)",
  "type": "object",
  "properties": {
    "schema": {
      "const": "yg-node/1"
    },
    "path": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "mapping": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NodeJsonRelation"
      }
    },
    "ports": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/NodeJsonPort"
      }
    },
    "children": {
      "description": "Direct children, model-relative POSIX, sorted.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parent": {
      "description": "Parent component, or null at the top of the hierarchy.",
      "type": [
        "null",
        "string"
      ]
    }
  },
  "required": [
    "schema",
    "path",
    "name",
    "type",
    "description",
    "mapping",
    "relations",
    "ports",
    "children",
    "parent"
  ],
  "additionalProperties": false,
  "$defs": {
    "NodeJsonPort": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "aspects": {
          "description": "Rule ids a consumer of this port must satisfy.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "description",
        "aspects"
      ],
      "additionalProperties": false
    },
    "NodeJsonRelation": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "consumes": {
          "description": "Ports consumed from the target — an empty list when the relation names none.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "event_name": {
          "description": "Event label, for the event relation types only.",
          "type": "string"
        }
      },
      "required": [
        "target",
        "type",
        "consumes"
      ],
      "additionalProperties": false
    }
  }
}
