{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krzysztofdudek.github.io/Yggdrasil/schemas/yg-context-1.schema.json",
  "title": "Context package (yg context --json)",
  "$comment": "This schema describes exactly what this release of Yggdrasil writes: every mapping is closed and every enumeration lists only the values this release uses. Use it to check a producer. Do not use it to reject a document you read: under the family rule a later release may add a field or a value within /1, and a /1 reader ignores what it does not know (see family-contracts).",
  "type": "object",
  "properties": {
    "schema": {
      "const": "yg-context/1"
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "file",
            "node"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "additionalProperties": false
    },
    "owner": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "node"
            },
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "type"
            },
            "typeId": {
              "type": "string"
            },
            "chainTermination": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "typeId",
            "chainTermination"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "none"
            },
            "reason": {
              "enum": [
                "excluded",
                "unmapped"
              ]
            },
            "explanation": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason",
            "explanation"
          ],
          "additionalProperties": false
        }
      ]
    },
    "chain": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContextJsonChainLink"
      }
    },
    "aspects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContextJsonAspect"
      }
    },
    "dropped": {
      "description": "Rules attached to the subject's type that do NOT apply here, with the reason. Type-governed files only.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "attention": {
      "description": "The advisory structural-attention sentence, when the text view would print one.",
      "type": "string"
    },
    "typeDecisions": {
      "description": "The decisions in force for the subject's type and every type above it, nearest first; absent when none is in force.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContextJsonTypeDecisions"
      }
    },
    "nodeLog": {
      "description": "The owning component's own log; absent for a file with no component and for a component whose log has no entry.",
      "$ref": "#/$defs/ContextJsonNodeLog"
    }
  },
  "required": [
    "schema",
    "target",
    "owner",
    "chain",
    "aspects"
  ],
  "additionalProperties": false,
  "$defs": {
    "ContextJsonAspect": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "description": "Effective status on this subject — the strongest across every channel below.",
          "enum": [
            "advisory",
            "draft",
            "enforced"
          ]
        },
        "kind": {
          "enum": [
            "aggregate",
            "deterministic",
            "llm"
          ]
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextJsonChannel"
          }
        },
        "impliedBy": {
          "description": "Aspects that imply this one on this subject (channel 7), when any do.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "read": {
          "description": "The files an agent must read before editing — the text view's `read:` lines.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "status",
        "kind",
        "name",
        "description",
        "channels",
        "read"
      ],
      "additionalProperties": false
    },
    "ContextJsonChainLink": {
      "type": "object",
      "properties": {
        "node": {
          "type": [
            "null",
            "string"
          ]
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "node",
        "type"
      ],
      "additionalProperties": false
    },
    "ContextJsonChannel": {
      "type": "object",
      "properties": {
        "number": {
          "description": "Channel number, 1–7, matching the cascade documented by `yg prime`.",
          "enum": [
            1,
            2,
            3,
            4,
            5,
            6,
            7
          ]
        },
        "kind": {
          "enum": [
            "ancestor-node",
            "ancestor-type",
            "flow",
            "implies",
            "own",
            "own-type",
            "port"
          ]
        },
        "origin": {
          "description": "Machine-readable origin token, e.g. `own:orders/handler`, `type:command`, `flow:checkout`, `port:charge@payments`.",
          "type": "string"
        },
        "declaredStatus": {
          "description": "Status declared AT this attachment site, when the site declares one.",
          "enum": [
            "advisory",
            "draft",
            "enforced"
          ]
        }
      },
      "required": [
        "number",
        "kind",
        "origin"
      ],
      "additionalProperties": false
    },
    "ContextJsonLogEntry": {
      "type": "object",
      "properties": {
        "datetime": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      },
      "required": [
        "datetime",
        "body"
      ],
      "additionalProperties": false
    },
    "ContextJsonLogUnreadable": {
      "type": "object",
      "properties": {
        "what": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "next": {
          "type": "string"
        }
      },
      "required": [
        "what",
        "why",
        "next"
      ],
      "additionalProperties": false
    },
    "ContextJsonNodeLog": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string"
        },
        "log": {
          "description": "The node log's path, repo-relative.",
          "type": "string"
        },
        "entries": {
          "description": "The entries given, oldest first; replaced entries are never among them.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextJsonLogEntry"
          }
        },
        "trimmed": {
          "description": "True when the node's type sets `log_required`, so only the newest entries in force are given.",
          "type": "boolean"
        },
        "omitted": {
          "description": "Entries in force the trim left out.",
          "type": "number"
        },
        "unreadable": {
          "description": "Why the log could not be read entry by entry, when it could not.",
          "$ref": "#/$defs/ContextJsonLogUnreadable"
        }
      },
      "required": [
        "node",
        "log",
        "entries",
        "trimmed",
        "omitted"
      ],
      "additionalProperties": false
    },
    "ContextJsonTypeDecisions": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "log": {
          "description": "The type log's path, repo-relative.",
          "type": "string"
        },
        "entries": {
          "description": "Entries no later entry replaced, oldest first. Empty when `unreadable` is set.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextJsonLogEntry"
          }
        },
        "unreadable": {
          "description": "Why the log could not be read entry by entry, when it could not.",
          "$ref": "#/$defs/ContextJsonLogUnreadable"
        }
      },
      "required": [
        "type",
        "log",
        "entries"
      ],
      "additionalProperties": false
    }
  }
}
