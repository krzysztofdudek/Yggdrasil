{
  "name": "@chrisdudek/yg",
  "version": "5.8.0",
  "description": "Say it once: a rule you write holds in every session after. Your AI coding agent gets only the rules that touch the file it is editing, and must satisfy them before it moves on. Free local checks, keyless CI. Works with Claude Code, Cursor, Copilot, Codex, Cline.",
  "type": "module",
  "bin": {
    "yg": "dist/bin.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.wasm",
    "dist/**/*.node-types.json",
    "dist/**/*.html",
    "dist/**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:external": "vitest run --config vitest.external.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e:portal": "playwright test",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.check.json",
    "typecheck:e2e": "tsc -p tests/portal-e2e/tsconfig.json"
  },
  "keywords": [
    "yggdrasil",
    "architecture-enforcement",
    "code-guardrails",
    "agentic-guardrails",
    "rule-engine",
    "agents-md",
    "claude-md",
    "claude-code",
    "ai-agents",
    "coding-agents",
    "ai-coding",
    "ai-assisted-development",
    "cli",
    "developer-tools"
  ],
  "author": "Krzysztof Dudek <me@chrisdudek.com>",
  "license": "MIT",
  "homepage": "https://github.com/krzysztofdudek/Yggdrasil#readme",
  "bugs": {
    "url": "https://github.com/krzysztofdudek/Yggdrasil/issues",
    "email": "me@chrisdudek.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krzysztofdudek/Yggdrasil.git",
    "directory": "source/cli"
  },
  "exports": {
    "./ast": {
      "import": "./dist/ast.js",
      "types": "./dist/ast.d.ts"
    },
    "./structure": {
      "import": "./dist/structure.js",
      "types": "./dist/structure.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "ignore": "^7.0.5",
    "minimatch": "^10.2.5",
    "minisearch": "^7.2.0",
    "semver": "^7.8.1",
    "smol-toml": "^1.6.1",
    "web-tree-sitter": "^0.26.9",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tree-sitter-grammars/tree-sitter-kotlin": "^1.1.0",
    "@tree-sitter-grammars/tree-sitter-toml": "^0.7.0",
    "@tree-sitter-grammars/tree-sitter-yaml": "^0.7.1",
    "@types/node": "^26.0.0",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-json": "^0.24.8",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
